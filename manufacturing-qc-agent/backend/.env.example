# IBM watsonx.ai credentials — copy this to .env and fill in your values
# Never commit the real .env file to source control.

# ---- REQUIRED for IBM Granite integration ----
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ---- Optional model settings ----
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9

# ---- App settings ----
DEBUG=false
MAX_DATASET_ROWS=10000

# ---- Threshold overrides (optional) ----
# TEMPERATURE_WARN=85.0
# TEMPERATURE_CRIT=95.0
# PRESSURE_WARN=7.5
# PRESSURE_CRIT=9.0
# SPEED_WARN=1800.0
# SPEED_CRIT=2100.0
# VIBRATION_WARN=0.6
# VIBRATION_CRIT=0.8
